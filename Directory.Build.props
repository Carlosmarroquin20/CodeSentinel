<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned (not 'latest') so a newer SDK on a dev box or CI runner cannot introduce
         analyzer rules that break the build through TreatWarningsAsErrors. -->
    <AnalysisLevel>9.0-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Product>CodeSentinel</Product>
    <Authors>CodeSentinel contributors</Authors>
    <Copyright>Copyright (c) CodeSentinel contributors</Copyright>
    <Version>0.1.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Single source of truth for the project's homepage. Consumed by Cli.csproj
         packaging metadata and exposed as assembly metadata for runtime lookup
         (e.g., the SARIF writer's informationUri field). -->
    <CodeSentinelProjectUrl>https://github.com/Ema322/CodeSentinel</CodeSentinelProjectUrl>
  </PropertyGroup>

  <ItemGroup Label="Assembly-level metadata for runtime lookup">
    <AssemblyMetadata Include="CodeSentinel.ProjectUrl" Value="$(CodeSentinelProjectUrl)" />
  </ItemGroup>

</Project>
